# Copy this file to .env.development (for `npm run develop`) and/or
# .env.production (for `npm run build` / `npm run deploy`), then fill in
# real values from your EmailJS account (https://dashboard.emailjs.com/).
#
# Must be prefixed with GATSBY_ so Gatsby inlines them into the browser
# bundle - plain (unprefixed) env vars are only available in Node.js code
# (gatsby-node.js/gatsby-config.ts), not in client-rendered components.

# Email Services -> your connected service's "Service ID"
GATSBY_EMAILJS_SERVICE_ID=

# Email Templates -> the template's "Template ID". Build a template with
# {{subject}}, {{from_email}}, {{message}}, {{artwork}} and {{to_email}}
# placeholders, and set "To Email" to {{to_email}} (or hardcode contact@vb-art.com).
GATSBY_EMAILJS_TEMPLATE_ID=

# Account -> General -> "Public Key"
GATSBY_EMAILJS_USER_ID=
